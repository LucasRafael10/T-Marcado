# Use valores reais somente no Render ou em um arquivo .env local ignorado pelo Git.
APP_ORIGIN=http://localhost:4173
DATABASE_URL=
# Se o Supabase exigir sua própria CA, copie o certificado de Database Settings.
# DATABASE_CA_CERT aceita o certificado PEM completo, com quebras de linha ou \n.
DATABASE_CA_CERT=
RESEND_API_KEY=
EMAIL_FROM=

# Não confie em X-Forwarded-For sem validar a cadeia de proxies do serviço.
TRUST_PROXY_HOPS=0
